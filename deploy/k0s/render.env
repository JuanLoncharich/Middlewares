# deploy.sh settings for the university k0s cluster, rendered by
# hack/gitops/render.sh into ./generated (synced by Flux). No secrets here:
# they are created once with hack/gitops/secrets.sh.
IMG_REGISTRY=docker.io/jjhonson
# CI overrides IMG_TAG with the commit it built (sha-<7>).
IMG_TAG=sha-368f80d
# No NetBird on k0s: gateways are reached as in-cluster services.
MESH_ENFORCE=false
# The demo/live UI (frontend/), read-only: kubectl -n mcp-eval-ui port-forward svc/mcp-eval-ui 8787:80
DEPLOY_UI=1
# The LLM runs on the GPU PC (hack/local-llm/llm with PUBLISH=<its ZeroTier IP>).
LLM_PROVIDER=local
LOCAL_LLM_URL=http://10.147.17.21:8080/v1
LLM_MODEL=lfm2.5-24b-a2b
LLM_CONTEXT_TOKENS=32768
# Vigil runs as one replica on the GPU PC node (patches/vigil-on-gpu-node.yaml).
VIGIL_REPLICAS=1
VIGIL_HPA_MIN=1
VIGIL_MAX_UNAVAILABLE=1
CHROMA_QUERY_REPLICAS=1
CHROMA_COMPACTION_REPLICAS=1
# Built locally from the git-ignored corpus file (hack/vigil-corpus), pushed once.
VIGIL_CORPUS_IMG=docker.io/jjhonson/vigil-corpus:e5s-v3-2d9653151abc
# kubectl get endpointslices -n default -l kubernetes.io/service-name=kubernetes
RENDER_API_PEERS=10.66.50.59
RENDER_API_PORT=6443
# One fixed entry point: MetalLB (L2) announces this range on the MD network
# (OpenStack subnet MD_ingress); Traefik takes the first address and serves
# the UI at https://10.66.51.11/ behind basic auth (hack/gitops/secrets.sh).
DEPLOY_INGRESS=1
INGRESS_IP_RANGE=10.66.51.11-10.66.51.20
