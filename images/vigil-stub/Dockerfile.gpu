# Vigil scanner — GPU variant (same code, same six engines; the three ONNX
# model engines run on the CUDA execution provider).
#
#   docker build -f Dockerfile.gpu -t vigil-stub:gpu .
#   docker run --rm --gpus all -p 5000:5000 vigil-stub:gpu
#
# Base image supplies the CUDA 12.8 runtime + cuDNN 9 that onnxruntime-gpu
# links against (12.8 is the first CUDA release with Blackwell / sm_120
# support, e.g. RTX 50xx). The driver itself comes from the host through the
# NVIDIA container runtime — nothing GPU-specific is baked in beyond this.
#
# Defaults to VIGIL_ORT_PROVIDER=cuda: if the GPU is not usable the engines
# report available=false instead of silently running on CPU.
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ARG ORT_GPU_VERSION=1.23.2

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-pip python3-venv ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /opt/venv

ENV PATH=/opt/venv/bin:$PATH

RUN pip install --no-cache-dir \
      onnxruntime-gpu==${ORT_GPU_VERSION} \
      tokenizers==0.20.3 \
      numpy==2.1.3 \
      yara-python==4.5.4 \
      vaderSentiment==3.3.2

COPY download-models.py /tmp/download-models.py
RUN python /tmp/download-models.py && rm /tmp/download-models.py

COPY rules/ /rules/

COPY server.py scanners.py embedder.py ortutil.py windowing.py /app/

RUN groupadd --gid 10004 vigil && useradd --uid 10004 --gid 10004 --no-create-home vigil
USER 10004:10004
ENV VIGIL_STUB_PORT=5000 \
    VIGIL_ORT_PROVIDER=cuda \
    VIGIL_ORT_CPU_MODELS=minilm \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility
EXPOSE 5000
CMD ["python", "/app/server.py"]
