{
  "name": "mcp-eval-runner",
  "version": "0.1.0",
  "description": "OpenCode-driven evaluator container for MCP server security evaluation runs",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "main": "dist/evaluator.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/evaluator.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.0",
    "@opencode-ai/sdk": "^1.18.31",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.0"
  }
}
