# gpu-node configuration TEMPLATE. Copy it and fill in your environment:
#
#   cp hack/gpu-node/gpu-node.conf.example hack/gpu-node/gpu-node.conf
#
# gpu-node.conf is git-ignored: it holds machine/network specifics (node IPs,
# ZeroTier network, jump host) that must not be committed. Any variable can
# also be overridden by exporting it before running gpu-node.
# Values marked CHANGE_ME have no usable default.

# --- cluster ---------------------------------------------------------------
KUBE_CONTEXT="${KUBE_CONTEXT:-k0s}"
NODE_NAME="${NODE_NAME:-gpu-worker}"
K0S_VERSION="${K0S_VERSION:-v1.35.4+k0s.0}"      # must match the cluster (kubectl get nodes)
GPU_NAMESPACE="${GPU_NAMESPACE:-security-gateways}"
GPU_DEPLOYMENT="${GPU_DEPLOYMENT:-vigil-gpu}"
# Image: built locally (hack/gpu-node/build-vigil-gpu.sh), then
# imported straight into the PC's k0s containerd under the name the pod uses.
GPU_IMAGE_LOCAL="${GPU_IMAGE_LOCAL:-vigil-llm-gpu:local}"
GPU_IMAGE_REF="${GPU_IMAGE_REF:-ghcr.io/security-eval/vigil-llm-gpu:20260930}"

# --- network (overlay that reaches the cluster nodes, e.g. a ZeroTier net) --
ZT_IFACE="${ZT_IFACE:-CHANGE_ME}"               # overlay interface on this PC (ip -br addr)
ZT_SUBNET="${ZT_SUBNET:-CHANGE_ME}"             # overlay CIDR, e.g. 10.0.100.0/24
NODE_LAN_SUBNET="${NODE_LAN_SUBNET:-CHANGE_ME}" # cluster nodes' LAN CIDR
# Cluster nodes: LAN address (what Calico advertises) -> ZeroTier address.
# VXLAN replies to a LAN address must go over ZeroTier, not the NAT gateway.
# Same order in both arrays, e.g. NODES_LAN=(192.0.2.10 192.0.2.11)
NODES_LAN=()
NODES_ZT=()

# --- join token (fetched once through the jump host; never printed) ---------
JUMP_HOST="${JUMP_HOST:-CHANGE_ME}"             # host holding the SSH key to the controller
CONTROLLER_SSH="${CONTROLLER_SSH:-CHANGE_ME}"   # user@controller-ip
TOKEN_FILE="${TOKEN_FILE:-/etc/k0s/worker.token}"
TOKEN_EXPIRY="${TOKEN_EXPIRY:-24h}"

# --- resource limits for everything the node runs ----------------------------
CPU_CORES="${CPU_CORES:-4}"                      # -> CPUQuota=400%
MEM_LIMIT_GIB="${MEM_LIMIT_GIB:-6}"              # -> MemoryMax (hard), MemoryHigh (-0.5 GiB). Full GPU Vigil measured ~3.4 GiB + k0s ~1 GiB
VRAM_LIMIT_BYTES="${VRAM_LIMIT_BYTES:-8589934592}"  # 8 GiB. Informational only: nothing enforces it for
                                                    # vigil-llm (torch); the old stub capped its onnxruntime arena

# --- scheduling identity (applied by k0s on every start) ---------------------
NODE_LABEL="${NODE_LABEL:-security.eval.io/gpu=nvidia}"
NODE_TAINT="${NODE_TAINT:-nvidia.com/gpu=present:NoSchedule}"

# --- timeouts (seconds) ------------------------------------------------------
READY_TIMEOUT="${READY_TIMEOUT:-300}"
DRAIN_TIMEOUT="${DRAIN_TIMEOUT:-120}"
